# Environment variables for NEOX Platform
# Copy this file to .env.local and update the values

# Application
VITE_APP_NAME=NEOX
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Plataforma de E-commerce Completa

# API Configuration
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_TIMEOUT=10000

# Authentication
VITE_JWT_SECRET=your-jwt-secret-key
VITE_TOKEN_REFRESH_INTERVAL=300000

# Payment Gateways
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_key
VITE_PAGSEGURO_EMAIL=your_pagseguro_email
VITE_PAGSEGURO_TOKEN=your_pagseguro_token
VITE_MERCADOPAGO_PUBLIC_KEY=your_mercadopago_key

# File Upload
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Analytics
VITE_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
VITE_FACEBOOK_PIXEL_ID=your_facebook_pixel_id

# Features Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_CHAT=true
VITE_ENABLE_MULTI_VENDOR=false

# Development
VITE_DEBUG_MODE=false
VITE_MOCK_API=true

# Production
VITE_ENABLE_SENTRY=true
VITE_SENTRY_DSN=your_sentry_dsn
